<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_background" android:padding="11dp" android:orientation="vertical">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"><TextView android:id="@+id/w_open" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="SANTA FE" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold"/><TextView android:id="@+id/w_refresh" android:layout_width="40dp" android:gravity="right" android:layout_height="wrap_content" android:text="↻" android:textColor="#73CAE1" android:textSize="20sp"/></LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center">
<TextView android:id="@+id/w_lock" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center" android:text="LOCK" android:textColor="#F3F8FA" android:textSize="13sp"/>
<TextView android:id="@+id/w_unlock" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center" android:text="UNLOCK" android:textColor="#F3F8FA" android:textSize="13sp"/>
<TextView android:id="@+id/w_start" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center" android:text="START" android:textColor="#73CAE1" android:textSize="13sp"/>
<TextView android:id="@+id/w_stop" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center" android:text="STOP" android:textColor="#F3F8FA" android:textSize="13sp"/>
</LinearLayout></LinearLayout>
