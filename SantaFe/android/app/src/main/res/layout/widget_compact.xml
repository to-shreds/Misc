<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_background" android:padding="12dp" android:orientation="vertical">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"><TextView android:id="@+id/w_open" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="SANTA FE" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold"/><TextView android:id="@+id/w_refresh" android:layout_width="36dp" android:gravity="right" android:layout_height="wrap_content" android:text="↻" android:textColor="#73CAE1" android:textSize="20sp"/></LinearLayout>
<TextView android:id="@+id/w_doors" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Loading doors…" android:textColor="#FFFFFF" android:textSize="14sp"/>
<TextView android:id="@+id/w_engine" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Loading engine…" android:textColor="#D3E0E7" android:textSize="13sp"/>
<TextView android:id="@+id/w_fuel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Fuel --" android:textColor="#D3E0E7" android:textSize="13sp"/>
<TextView android:id="@+id/w_updated" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:singleLine="true" android:ellipsize="end" android:text="Not yet loaded" android:textColor="#A6B6C2" android:textSize="10sp"/>
</LinearLayout>
